{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MyDefrag locale component catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "locale",
    "component",
    "entries"
  ],
  "properties": {
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "component": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9_-]+)+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "status"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "translation-status.schema.json#/definitions/reviewState"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
