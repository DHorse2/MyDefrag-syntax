{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MyDefrag preview mode definitions",
  "type": "object",
  "required": [
    "defaultMode",
    "modes"
  ],
  "properties": {
    "defaultMode": {
      "type": "string"
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "$ref": "translation-status.schema.json#/definitions/reviewState"
          }
        }
      }
    }
  }
}
